# .streamlit/secrets.toml.example
# Copy this file to .streamlit/secrets.toml and fill in your actual credentials.
# NOTE: .streamlit/secrets.toml is git-ignored and should NEVER be committed to version control.

# The Odds API Key (https://the-odds-api.com/)
ODDS_API_KEY = "your_the_odds_api_key_here"

# ESPN Fantasy Football Integration
ESPN_LEAGUE_ID = "12345678"
ESPN_YEAR = "2026"

# ESPN Private League Authentication (Leave empty for public leagues)
# Find these cookies in browser developer tools (Application -> Cookies -> espn.com)
ESPN_S2 = "your_espn_s2_cookie_string_here"
ESPN_SWID = "{YOUR-SWID-UUID-HERE}"
